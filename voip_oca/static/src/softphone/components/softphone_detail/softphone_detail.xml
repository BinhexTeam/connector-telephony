<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="voip_oca.SoftphoneDetail">
        <div class="o-voip-SoftphoneDetail d-flex flex-column align-items-center">
            <div class="d-flex align-items-start w-100 px-1">
                <button class="btn" t-on-click="onDetailBack">
                <i class="fa fa-2x fa-chevron-left" />
            </button>
            </div>
            <div class="d-flex justify-content-center align-items-center">
                <img
                    class="text-fluid w-100 h-100 rounded-circle mt-3"
                    t-att-src="props.detailPhone.avatarUrl"
                />
            </div>
            <t t-if="partner">
                <div
                    class="d-flex flex-column justify-content-center align-items-center mt-1 text-muted w-100"
                >
                    <span class="mt-2" t-esc="partner.name" />
                    <span class="mt-2" t-esc="partner.displayName" />
                    <span class="mt-2" t-esc="callMobileNumber" />
                    <span class="mt-2" t-if="detailCall">
                        <i class="px-2" t-att-class="detailCall.iconTypeCall" />
                        <t t-esc="detailCall.callDate" />
                        <t t-if="detailCall.duration"> • <t
                                t-esc="detailCall.durationString"
                            /></t>
                    </span>
                </div>
            </t>
            <div
                class="d-flex flex-column justify-content-center w-100 o-phone-actions"
            >
                <div class="fw-bold fs-5 p-3">
                    Actions
                </div>
                <div class="d-flex justify-content-between px-3">
                    <button
                        class="btn p-3"
                        title="Send email"
                        t-on-click="() => this.onActions('email')"
                    ><i class="fa fa-2x fa-envelope-o" /></button>
                    <button
                        class="btn p-3"
                        title="Info contact"
                        t-on-click="() => this.onActions('info')"
                    ><i class="fa fa-2x  fa-user" /></button>
                    <button
                        class="btn p-3"
                        title="Schedule activity"
                        t-on-click="() => this.onActions('activity')"
                    ><i class="fa fa-2x fa-clock-o" /></button>
                </div>
            </div>


        </div>
    </t>
</templates>
