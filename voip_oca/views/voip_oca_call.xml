<?xml version="1.0" encoding="utf-8" ?>
<odoo>
        <record id="voip_oca_call_tree_view" model="ir.ui.view">
            <field name="name">voip.oca.call.tree</field>
            <field name="model">voip.oca.call</field>
            <field name="arch" type="xml">
                <tree editable="top">
                    <field name="display_name" />
                    <field name="phone_number" />
                    <field name="direction" />
                    <field name="state" />
                    <field name="start_date" />
                    <field name="end_date" />
                    <field name="user_id" />
                    <field name="partner_id" />
                </tree>
            </field>
        </record>

        <record id="voip_oca_call_act_window_tree" model="ir.actions.act_window">
            <field name="name">Calls</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">voip.oca.call</field>
            <field name="view_mode">tree</field>
        </record>
</odoo>
