<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="voip_oca.PhoneContact">
        <t t-if="voip_oca.phoneModel.contacts.length > 0">
                <div
                t-foreach="voip_oca.phoneModel.contacts"
                t-as="contact"
                t-key="contact.localId"
                class="list-group-item-action p-3 text-truncate cursor-pointer"
                t-on-click="(ev) => this.onClickContact(ev, contact)"
            >
                    <img
                    class="o_image_40_cover rounded"
                    t-att-src="getAvatarUrl(contact)"
                />
                    <span
                    class="ps-2 fw-bolder text-truncate"
                    t-att-title="contact.displayName"
                    t-esc="contact.displayName"
                />
                </div>
            </t>
    </t>
</templates>
