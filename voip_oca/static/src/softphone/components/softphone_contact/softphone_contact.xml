<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="voip_oca.SoftphoneContact">

        <t t-if="props.contacts.length > 0">
        <t t-foreach="props.contacts" t-as="contact" t-key="contact.id">
            <div
                    class="o-voip-SoftphoneContact d-flex bg-white px-3 pt-2 cursor-pointer m-2"
                    t-on-click="() => this.onClickContact(contact)"
                >
                <div class="row">
                    <div class="col-2">
                        <img
                                class="text-fluid w-100 h-75 rounded-circle"
                                t-att-src="imagePartner(contact)"
                            />
                    </div>
                    <div class="col-8">
                        <div class="fw-bold" t-esc="contact.name" />
                        <div t-esc="contact.displayName" />
                    </div>
                </div>
            </div>
        </t>
    </t>


