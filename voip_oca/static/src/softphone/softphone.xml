<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="voip_oca.VoipOCASoftphone">
        <div
            t-attf-class="o-voip-VoipOCASoftphone position-absolute d-flex flex-column bg-white w-100 w-md-25 h-100 mx-0 mx-md-3 bottom-0 shadow ml-3
            #{ phoneModel.isFolded ? 'h-md-75' : 'h-5'}"
        >
            <div
                class="o-voip-VoipOCASoftphone-bar p-2 text-white d-flex justify-content-between align-items-center h-auto cursor-pointer"
                t-on-click="onClickBar"
            >
                <div>
                    <span class="oi oi-large oi-voip mx-2" />
                    <span class="text-white">Voip</span>
                </div>
                <div>
                <button
                        class="btn btn-small text-white border-0 shadow-none"
                        type="button"
                        t-on-click="onClosePhone"
                    >
                    <i class="fa fa-close" />
                </button>
                </div>
            </div>
            <div class="o-voip-VoipOCASoftphone-content" t-if="phoneModel.isFolded">
                <SoftphoneNumpad t-if="this.phoneModel.enableNumpad" />

                <t t-if="!this.phoneModel.enableNumpad">
                    <SoftphoneDetail
                        t-if="phoneDetail"
                        detailPhone="phoneModel.selectedDetail"
                    />
                    <div t-else="">
                    <div class="d-flex">
                            <input
                                class="form-control border-0 shadow-none"
                                placeholder="Search"
                                t-model.trim="phoneModel.searchInputValue"
                                t-ref="searchInput"
                                t-on-input="onInputSearchBar"
                            />
                        <button class="oi oi-search btn shadow-none px-2" />
                        </div>
                        <ul class="nav nav-tabs text-center">
                  <li
                                class="nav-item fs-5 fw-bold"
                                t-foreach="tabList"
                                t-as="tab"
                                t-key="tab.id"
                            >
                    <a
                                    t-attf-class="nav-link #{phoneModel.activeTabId == tab.id ? 'active' : ''}"
                                    aria-current="page"
                                    href="#"
                                    t-att-data-id="tab.id"
                                    role="tab"
                                    t-esc="tab.name"
                                    data-bs-toggle="tab"
                                    t-on-click="onClickTab"
                                />
                  </li>
                </ul>
                        <div class="tab-content overflow-y-auto ">
                    <SoftphoneRecent
                                t-if="activeTabId == 'recent'"
                                recentCalls="phoneModel.recentCalls"
                            />
                            <SoftphoneActivity t-if="activeTabId == 'activity'" />
                            <SoftphoneContact
                                contacts="phoneModel.contacts"
                                t-if="activeTabId == 'contacts'"
                            />
                </div>
                </div>
                </t>
            </div>

            <div
                class="d-flex justify-content-around align-items-center o-voip-VoipOCASoftphone-footer mh-25"
            >
                 <button
                    class="btn p-3 shadow-none"
                    title="Open numpad"
                    t-on-click="openNumpad"
                ><i class="fa fa-3x fa-keyboard-o" /></button>
                <button
                    class="btn p-3 shadow-none"
                    title="Call"
                    t-on-click="onCallFooter"
                ><i class="fa fa-3x fa-phone" /></button>
            </div>
        </div>
    </t>
</templates>
